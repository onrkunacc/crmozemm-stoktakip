@model List<HospitalInventoryManagement.Data.Models.Hospital>
@{
    ViewData["Title"] = "Hastaneler";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stockCounts = ViewBag.StockCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold mb-0">Hastaneler</h3>
        <span class="badge bg-primary fs-6">@Model.Count kayıt</span>
    </div>

    <div class="row">
        <!-- Ekleme -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">Yeni Hastane Ekle</h5>
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Hastane Adı</label>
                            <input type="text" name="hospitalName" class="form-control" placeholder="Örn. Acıpayam Devlet Hastanesi" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Ekle</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Liste -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">Kayıtlı Hastaneler</h5>
                    @if (!Model.Any())
                    {
                        <p class="text-muted mb-0">Henüz hastane yok.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Hastane</th>
                                        <th class="text-end">Stok Kaydı</th>
                                        <th class="text-end">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in Model)
                                    {
                                        var count = stockCounts.ContainsKey(h.HospitalID) ? stockCounts[h.HospitalID] : 0;
                                        <tr>
                                            <td class="fw-semibold">@h.HospitalName</td>
                                            <td class="text-end">@count</td>
                                            <td class="text-end">
                                                <a asp-action="Edit" asp-route-id="@h.HospitalID" class="btn btn-sm btn-warning">Düzenle</a>
                                                <form asp-action="Delete" asp-route-id="@h.HospitalID" method="post" class="d-inline"
                                                      onsubmit="return confirm('@h.HospitalName silinsin mi?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger" @(count > 0 ? "disabled title='Stok kaydı var, silinemez'" : "")>Sil</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
