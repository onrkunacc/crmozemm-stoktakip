@model HospitalInventoryManagement.Web.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "Kullanıcı Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="fw-semibold mb-3">Kullanıcı Ekle</h4>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-posta</label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@ozemmedikal.com" />
                            <small class="text-muted">Kullanıcı adı e-postanın @@ öncesinden türetilir.</small>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Şifre</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Şifre" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Şifre (Tekrar)</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Şifre tekrar" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="HospitalID" class="form-label">Hastane</label>
                            <select asp-for="HospitalID" asp-items="ViewBag.Hospitals" class="form-select">
                                <option value="">Hastane seçin...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Rol</label>
                            <select asp-for="Role" class="form-select">
                                <option value="User">Kullanıcı (User)</option>
                                <option value="Admin">Yönetici (Admin)</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Kullanıcıyı Oluştur</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("UserList", "Admin")">Kullanıcı Listesi</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
