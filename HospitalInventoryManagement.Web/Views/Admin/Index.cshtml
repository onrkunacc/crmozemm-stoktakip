@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold mb-0">Yönetim Paneli</h3>
        <span class="badge bg-primary fs-6">Tüm Hastaneler</span>
    </div>

    <!-- Özet kartlar -->
    <div class="row">
        <div class="col-sm-6 col-lg-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="round-48 d-flex align-items-center justify-content-center rounded bg-primary-subtle">
                            <i class="ti ti-building-hospital fs-6 text-primary"></i>
                        </span>
                        <div>
                            <h4 class="fw-semibold mb-0">@ViewBag.TotalHospitals</h4>
                            <span class="text-muted">Hastane</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="round-48 d-flex align-items-center justify-content-center rounded bg-info-subtle">
                            <i class="ti ti-package fs-6 text-info"></i>
                        </span>
                        <div>
                            <h4 class="fw-semibold mb-0">@ViewBag.TotalProducts</h4>
                            <span class="text-muted">Ürün Çeşidi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="round-48 d-flex align-items-center justify-content-center rounded bg-success-subtle">
                            <i class="ti ti-flask fs-6 text-success"></i>
                        </span>
                        <div>
                            <h4 class="fw-semibold mb-0">@(((int)ViewBag.TotalTests).ToString("N0"))</h4>
                            <span class="text-muted">Toplam Test (Stok)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="round-48 d-flex align-items-center justify-content-center rounded bg-danger-subtle">
                            <i class="ti ti-calendar-time fs-6 text-danger"></i>
                        </span>
                        <div>
                            <h4 class="fw-semibold mb-0">@ViewBag.ExpiringSoonCount</h4>
                            <span class="text-muted">SKT 60 Gün İçinde</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafik -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="card-title fw-semibold mb-1" id="chartTitle">Hastane Bazında Test Stoğu</h5>
                    <p class="text-muted mb-0">Kutu altı ürün sayısı: <span class="fw-semibold text-warning">@ViewBag.LowStockCount</span></p>
                </div>
                <div style="min-width:260px;">
                    <select id="hospitalSelect" class="form-select">
                        <option value="">Tüm Hastaneler</option>
                        @foreach (var hospital in ViewBag.Hospitals)
                        {
                            <option value="@hospital.HospitalID">@hospital.HospitalName</option>
                        }
                    </select>
                </div>
            </div>
            <canvas id="stockChart" height="110"></canvas>
            <p id="noData" class="text-muted mt-2" style="display:none;">Gösterilecek veri yok.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('stockChart').getContext('2d');
        const titleEl = document.getElementById('chartTitle');
        const noData = document.getElementById('noData');
        const select = document.getElementById('hospitalSelect');
        let stockChart;

        async function updateChart(hospitalId) {
        const res = await fetch(`/Admin/GetHospitalStocks?hospitalId=${hospitalId || ''}`);
        const data = await res.json();

        const labels = data.map(x => x.label ?? x.Label);
        const values = data.map(x => x.total ?? x.Total);

        noData.style.display = data.length ? 'none' : 'block';

        if (hospitalId) {
        const name = select.options[select.selectedIndex].text;
        titleEl.textContent = `${name} — Ürün Bazında Test Stoğu`;
        } else {
        titleEl.textContent = 'Hastane Bazında Test Stoğu';
        }

        if (stockChart) stockChart.destroy();
        stockChart = new Chart(ctx, {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [{
        label: 'Test Stoğu',
        data: values,
        backgroundColor: 'rgba(93, 135, 255, 0.6)',
        borderColor: 'rgba(93, 135, 255, 1)',
        borderWidth: 1,
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
        });
        }

        select.addEventListener('change', function () { updateChart(this.value); });
        updateChart();
    </script>
}
