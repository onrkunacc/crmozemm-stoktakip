<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - OZEM</title>
    <link rel="shortcut icon" type="image/png" href="~/Modernize-1.0.0/src/assets/images/logos/logo.jpg" />
    <link rel="stylesheet" href="~/Modernize-1.0.0/src/assets/css/styles.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <style>
        /* Bağımsız mobil menü  altına eklenir, template CSS'inden etkilenmez */
        #mobileMenu {
            position: fixed;
            top: 0; left: 0; bottom: 0;
            width: 270px; max-width: 84vw;
            background: #fff;
            z-index: 2000;
            transform: translateX(-100%);
            transition: transform .25s ease;
            overflow-y: auto;
            box-shadow: 2px 0 16px rgba(0,0,0,.20);
        }
        #mobileMenu.open { transform: translateX(0); }

        #mobileMenu .mm-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 16px; border-bottom: 1px solid #eee;
        }
        #mobileMenu .sidebar-nav { padding: 8px 6px; }
        #mobileMenu .hide-menu { display: inline-block !important; }
        #mobileMenu .sidebar-link {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; border-radius: 8px; color: #2a3547; text-decoration: none;
        }
        #mobileMenu .sidebar-link:hover { background: #f2f4f7; }
        #mobileMenu .nav-small-cap { padding: 12px 14px 4px; font-size: 12px; color: #8a94a6; text-transform: uppercase; }
        #mobileMenu ul { list-style: none; margin: 0; padding-left: 0; }

        #sidebarBackdrop {
            position: fixed; inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1990; display: none;
        }
        #sidebarBackdrop.show { display: block; }

        /* Masaüstünde mobil menü tamamen gizli */
        @@media (min-width: 768px) {
            #mobileMenu, #sidebarBackdrop { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
         data-sidebar-position="fixed" data-header-position="fixed">
        <aside class="left-sidebar closed collapse d-md-block" id="sidebar">
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <a href="@Url.Action("Index", "Home")" class="text-nowrap logo-img">
                        <img src="~/Modernize-1.0.0/src/assets/images/logos/logo.jpg" width="180" alt="" />
                    </a>
                </div>
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Index", "Home")" aria-expanded="false">
                                <span><i class="ti ti-home"></i></span>
                                <span class="hide-menu">Anasayfa</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Index", "Admin")" aria-expanded="false">
                                <span><i class="ti ti-graph"></i></span>
                                <span class="hide-menu">Grafik</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Index", "Hospital")" aria-expanded="false">
                                <span><i class="ti ti-building-hospital"></i></span>
                                <span class="hide-menu">Hastaneler - Hastane Ekle</span>
                            </a>
                        </li>
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                            <span class="hide-menu">ÜRÜN İŞLEMLERİ</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Create", "Product")" aria-expanded="false">
                                <span><i class="ti ti-circle-plus"></i></span>
                                <span class="hide-menu">Ürün Ekle</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Index", "Product")" aria-expanded="false">
                                <span><i class="ti ti-list"></i></span>
                                <span class="hide-menu">Ürün Listesi</span>
                            </a>
                        </li>
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                            <span class="hide-menu">STOK İŞLEMLERİ</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("BarcodeCount", "Stock")" aria-expanded="false">
                                <span><i class="ti ti-checklist"></i></span>
                                <span class="hide-menu">Barkod Sayımı</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Transfer", "Stock")" aria-expanded="false">
                                <span><i class="ti ti-arrows-exchange"></i></span>
                                <span class="hide-menu">Hastaneler Arası Aktarım</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="@Url.Action("Index", "Stock")" aria-expanded="false">
                                <span><i class="ti ti-list-check"></i></span>
                                <span class="hide-menu">Stok Listesi</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="body-wrapper sidebar-collapsed">
            <!-- Header -->
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light bg-light">
                    <div class="container-fluid">
                        <!-- Mobil hamburger -->
                        <button type="button" class="btn btn-outline-secondary d-md-none" onclick="__toggleSidebar()" aria-label="Menü">
                            <i class="fas fa-bars"></i>
                        </button>

                        <!-- Sağ üst köşede kullanıcı bilgisi -->
                        <div class="d-flex align-items-center ms-auto">
                            @if (User.Identity.IsAuthenticated)
                            {
                                @await Html.PartialAsync("_UserHospitalInfo")
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary">
                                    <i class="ti ti-login"></i> Giriş Yap
                                </a>
                            }
                        </div>
                    </div>
                </nav>
            </header>

            <!-- Ana İçerik -->
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
        <!-- Sidebar End -->
    </div>

    <!-- Bağımsız mobil menü + arka plan (body'nin doğrudan çocuğu) -->
    <div id="sidebarBackdrop"></div>
    <div id="mobileMenu">
        <div class="mm-head">
            <img src="~/Modernize-1.0.0/src/assets/images/logos/logo.jpg" width="140" alt="OZEM" />
            <button type="button" class="btn btn-close" onclick="__toggleSidebar()" aria-label="Kapat"></button>
        </div>
        <div id="mobileMenuInner"></div>
    </div>

    <!-- Scripts -->
    <script src="~/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
    <script src="~/Modernize-1.0.0/src/assets/js/dashboard.js"></script>

    <!-- Mobil menü aç/kapat -->
    <script>
        (function () {
            function mm() { return document.getElementById('mobileMenu'); }
            function bd() { return document.getElementById('sidebarBackdrop'); }
            function closeMenu() { mm().classList.remove('open'); bd().classList.remove('show'); }
            function openMenu() { mm().classList.add('open'); bd().classList.add('show'); }

            window.__toggleSidebar = function () {
                mm().classList.contains('open') ? closeMenu() : openMenu();
            };

            document.addEventListener('DOMContentLoaded', function () {
                // Menü linklerini mevcut sidebar'dan klonla (tek kaynak)
                var src = document.getElementById('sidebarnav');
                var inner = document.getElementById('mobileMenuInner');
                if (src && inner) {
                    inner.innerHTML = '<ul class="sidebar-nav">' + src.innerHTML + '</ul>';
                }

                var backdrop = bd();
                if (backdrop) backdrop.addEventListener('click', closeMenu);

                // Bir menü linkine tıklanınca kapat
                inner.querySelectorAll('a.sidebar-link').forEach(function (a) {
                    a.addEventListener('click', closeMenu);
                });
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
