@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<HospitalInventoryManagement.Data.Models.Product>

@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int pageSize = ViewBag.PageSize != null
        ? Convert.ToInt32(ViewBag.PageSize)
        : 20;

    string? search = ViewBag.Search as string;

    int? selectedCategoryId = ViewBag.CategoryId != null
        ? Convert.ToInt32(ViewBag.CategoryId)
        : null;

    int? selectedProductTypeId = ViewBag.ProductTypeId != null
        ? Convert.ToInt32(ViewBag.ProductTypeId)
        : null;

    int? selectedPlatformId = ViewBag.PlatformId != null
        ? Convert.ToInt32(ViewBag.PlatformId)
        : null;

    bool hasFilters =
        !string.IsNullOrWhiteSpace(search) ||
        selectedCategoryId.HasValue ||
        selectedProductTypeId.HasValue ||
        selectedPlatformId.HasValue;
}

<div class="product-page">

    <!-- Sayfa başlığı -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Ürün Listesi</h1>

            <p class="page-description">
                Sistemde kayıtlı ürünleri görüntüleyebilir, arayabilir ve
                filtreleyebilirsiniz.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-primary add-product-button">
                <span class="add-icon">+</span>
                Yeni Ürün Girişi
            </a>
        }
    </div>

    <!-- Başarı ve hata mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <!-- Arama ve filtreleme -->
    <div class="filter-card">
        <form method="get"
              asp-controller="Product"
              asp-action="Index"
              id="filterForm">

            <input type="hidden" name="page" value="1" />

            <div class="row g-3">

                <!-- Arama -->
                <div class="col-12 col-xl-4">
                    <label for="search" class="form-label">
                        Ürün Ara
                    </label>

                    <div class="search-container">
                        <span class="search-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="M20 20L16.65 16.65"></path>
                            </svg>
                        </span>

                        <input type="search"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control search-input"
                               placeholder="Ürün adı veya referans numarası..."
                               autocomplete="off" />
                    </div>
                </div>

                <!-- Kategori -->
                <div class="col-12 col-md-6 col-xl-2">
                    <label for="categoryId" class="form-label">
                        Kategori
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            class="form-select"
                            asp-items="ViewBag.Categories">
                        <option value="">Tüm kategoriler</option>
                    </select>
                </div>

                <!-- Ürün tipi -->
                <div class="col-12 col-md-6 col-xl-2">
                    <label for="productTypeId" class="form-label">
                        Ürün Tipi
                    </label>

                    <select id="productTypeId"
                            name="productTypeId"
                            class="form-select"
                            asp-items="ViewBag.ProductTypes">
                        <option value="">Tüm ürün tipleri</option>
                    </select>
                </div>

                <!-- Platform -->
                <div class="col-12 col-md-6 col-xl-2">
                    <label for="platformId" class="form-label">
                        Platform
                    </label>

                    <select id="platformId"
                            name="platformId"
                            class="form-select"
                            asp-items="ViewBag.Platforms">
                        <option value="">Tüm platformlar</option>
                    </select>
                </div>

                <!-- Sayfa boyutu -->
                <div class="col-12 col-md-6 col-xl-2">
                    <label for="pageSize" class="form-label">
                        Sayfa Başına
                    </label>

                    <select id="pageSize"
                            name="pageSize"
                            class="form-select">

                        @foreach (int size in new[] { 20, 50, 100 })
                        {
                            if (size == pageSize)
                            {
                                <option value="@size" selected>
                                    @size ürün
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size ürün
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Butonlar -->
                <div class="col-12">
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary">
                            Ara ve Filtrele
                        </button>

                        @if (hasFilters)
                        {
                            <a asp-controller="Product"
                               asp-action="Index"
                               asp-route-pageSize="@pageSize"
                               class="btn btn-light clear-filter-button">
                                Filtreleri Temizle
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Sonuç özeti -->
    <div class="result-summary">
        <div>
            Toplam <strong>@Model.TotalItemCount</strong> ürün bulundu
        </div>

        @if (Model.PageCount > 0)
        {
            <div>
                Sayfa <strong>@Model.PageNumber</strong> / @Model.PageCount
            </div>
        }
    </div>

    <!-- Ürün tablosu -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="table product-table align-middle">
                <thead>
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Referans Numarası</th>
                        <th class="text-center">Kutu Test Adedi</th>
                        <th class="text-center">Flakon Sayısı</th>
                        <th>Kategori</th>
                        <th>Ürün Tipi</th>
                        <th>Platform</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Ürün adı -->
                                <td>
                                    <div class="product-name">
                                        @item.ProductName
                                    </div>
                                </td>

                                <!-- Referans numarası -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ReferenceNumber))
                                    {
                                        <span class="reference-badge">
                                            @item.ReferenceNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="empty-value">—</span>
                                    }
                                </td>

                                <!-- Kutu test adedi -->
                                <td class="text-center numeric-value">
                                    @item.BoxTextCount
                                </td>

                                <!-- Flakon sayısı -->
                                <td class="text-center numeric-value">
                                    @item.FlaconCountPerBox
                                </td>

                                <!-- Kategori -->
                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="category-badge">
                                            @item.Category.CategoryName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="empty-value">—</span>
                                    }
                                </td>

                                <!-- Ürün tipi -->
                                <td>
                                    @if (item.ProductType != null)
                                    {
                                        @item.ProductType.TypeName
                                    }
                                    else
                                    {
                                        <span class="empty-value">—</span>
                                    }
                                </td>

                                <!-- Platform -->
                                <td>
                                    @if (item.Platform != null)
                                    {
                                        @item.Platform.PlatformName
                                    }
                                    else
                                    {
                                        <span class="empty-value">—</span>
                                    }
                                </td>

                                <!-- İşlemler -->
                                <td class="text-end">
                                    <div class="action-buttons">
                                        <a asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@item.ProductID"
                                           class="btn btn-sm btn-outline-info">
                                            Detay
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@item.ProductID"
                                               class="btn btn-sm btn-outline-warning">
                                                Düzenle
                                            </a>

                                            <a asp-controller="Product"
                                               asp-action="Delete"
                                               asp-route-id="@item.ProductID"
                                               class="btn btn-sm btn-outline-danger">
                                                Sil
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state-icon">⌕</div>

                                    <h3>Ürün bulunamadı</h3>

                                    <p>
                                        Arama kelimesini veya seçtiğiniz filtreleri
                                        değiştirerek tekrar deneyebilirsiniz.
                                    </p>

                                    @if (hasFilters)
                                    {
                                        <a asp-controller="Product"
                                           asp-action="Index"
                                           asp-route-pageSize="@pageSize"
                                           class="btn btn-outline-primary">
                                            Filtreleri Temizle
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sayfalama -->
    @if (Model.PageCount > 1)
    {
        <div class="pagination-container">
            @Html.PagedListPager(
                Model,
                currentPage => Url.Action(
                    "Index",
                    "Product",
                    new
                    {
                        page = currentPage,
                        pageSize = pageSize,
                        search = search,
                        categoryId = selectedCategoryId,
                        productTypeId = selectedProductTypeId,
                        platformId = selectedPlatformId
                    }),
                new PagedListRenderOptions
                {
                    Display = PagedListDisplayMode.IfNeeded,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                    DisplayLinkToLastPage = PagedListDisplayMode.Never,
                    MaximumPageNumbersToDisplay = 5,
                    LinkToPreviousPageFormat = "‹ Önceki",
                    LinkToNextPageFormat = "Sonraki ›",
                    UlElementClasses = new[]
                    {
                        "pagination",
                        "product-pagination"
                    },
                    LiElementClasses = new[]
                    {
                        "page-item"
                    },
                    PageClasses = new[]
                    {
                        "page-link"
                    }
                })
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterForm = document.getElementById("filterForm");

            const automaticFilters = [
                document.getElementById("categoryId"),
                document.getElementById("productTypeId"),
                document.getElementById("platformId"),
                document.getElementById("pageSize")
            ];

            automaticFilters.forEach(function (element) {
                if (element) {
                    element.addEventListener("change", function () {
                        filterForm.submit();
                    });
                }
            });
        });
    </script>
}

<style>
    :root {
        --product-primary: #2563eb;
        --product-primary-hover: #1d4ed8;
        --product-border: #e2e8f0;
        --product-background: #f8fafc;
        --product-text: #0f172a;
        --product-muted: #64748b;
    }

    .product-page {
        padding-bottom: 40px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-title {
        color: var(--product-text);
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .page-description {
        color: var(--product-muted);
        margin: 0;
    }

    .add-product-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .add-icon {
        font-size: 20px;
        line-height: 1;
    }

    .filter-card,
    .table-card {
        background-color: #fff;
        border: 1px solid var(--product-border);
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    }

    .filter-card {
        padding: 20px;
        margin-bottom: 18px;
    }

    .form-label {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 42px;
        border-color: #cbd5e1;
        border-radius: 8px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

    .search-container {
        position: relative;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 13px;
        width: 18px;
        height: 18px;
        transform: translateY(-50%);
        pointer-events: none;
    }

        .search-icon svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: #94a3b8;
            stroke-linecap: round;
            stroke-width: 2;
        }

    .search-input {
        padding-left: 41px;
    }

    .filter-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 3px;
    }

        .filter-actions .btn {
            min-width: 130px;
            border-radius: 8px;
        }

    .clear-filter-button {
        color: #475569;
        border: 1px solid var(--product-border);
    }

    .result-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--product-muted);
        font-size: 14px;
        margin: 0 3px 10px;
    }

        .result-summary strong {
            color: var(--product-text);
        }

    .table-card {
        overflow: hidden;
    }

    .product-table {
        min-width: 1050px;
        margin: 0;
    }

        .product-table thead th {
            padding: 14px 16px;
            background-color: var(--product-background);
            border-bottom: 1px solid var(--product-border);
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .product-table tbody td {
            padding: 14px 16px;
            border-color: #edf2f7;
            color: #334155;
            font-size: 14px;
            vertical-align: middle;
        }

        .product-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .product-table tbody tr:hover {
                background-color: #f8fbff;
            }

    .product-name {
        min-width: 170px;
        color: var(--product-text);
        font-weight: 600;
    }

    .numeric-value {
        font-weight: 600;
    }

    .reference-badge,
    .category-badge {
        display: inline-block;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 9px;
        white-space: nowrap;
    }

    .reference-badge {
        background-color: #f1f5f9;
        color: #475569;
    }

    .category-badge {
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .empty-value {
        color: #94a3b8;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        white-space: nowrap;
    }

        .action-buttons .btn {
            border-radius: 6px;
        }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-state-icon {
        color: #94a3b8;
        font-size: 50px;
        line-height: 1;
        margin-bottom: 10px;
    }

    .empty-state h3 {
        color: var(--product-text);
        font-size: 18px;
        margin-bottom: 8px;
    }

    .empty-state p {
        max-width: 460px;
        margin: 0 auto 18px;
        color: var(--product-muted);
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }

    .product-pagination {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;
        margin: 0;
    }

        .product-pagination .page-item {
            margin: 0;
        }

        .product-pagination .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            height: 40px;
            border: 1px solid var(--product-border);
            border-radius: 8px;
            color: #475569;
            font-size: 14px;
            text-decoration: none;
        }

            .product-pagination .page-link:hover {
                background-color: #eff6ff;
                border-color: #bfdbfe;
                color: var(--product-primary);
            }

        .product-pagination .active .page-link {
            background-color: var(--product-primary);
            border-color: var(--product-primary);
            color: #fff;
        }

        .product-pagination .disabled .page-link {
            background-color: #f8fafc;
            color: #cbd5e1;
            pointer-events: none;
        }

    @@media (max-width: 767.98px) {
        .page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .add-product-button {
            width: 100%;
        }

        .filter-actions {
            flex-direction: column;
        }

            .filter-actions .btn {
                width: 100%;
            }

        .result-summary {
            align-items: flex-start;
            flex-direction: column;
            gap: 4px;
        }
    }
</style>